APP_ENV=development
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=mst_database
DB_USERNAME=root
DB_PASSWORD=
FRONTEND_ORIGIN=http://localhost:8000,http://127.0.0.1:8000
# Optional: VirusTotal hash lookup for file scans (free key: https://www.virustotal.com/gui/join-us).
# Only SHA-256 hashes are sent. Leave empty to scan without VirusTotal.
VIRUSTOTAL_API_KEY=
# Free keys allow 4 VirusTotal requests per minute; MST waits instead of going over the limit.
VIRUSTOTAL_REQUESTS_PER_MINUTE=4
# Phase 13 file scanner (uploads on the File Scanner page): auto | defender | clamav | none
SCAN_ENGINES=auto
SCAN_TIMEOUT_SECONDS=120
# Only needed if MST cannot find them by itself:
DEFENDER_PATH=
CLAMAV_PATH=
# Maximum upload size in MB (at most 32). php.ini upload_max_filesize / post_max_size must also allow it.
MAX_UPLOAD_MB=32
