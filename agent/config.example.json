{
  "server_url": "http://192.168.1.10:8081/api",
  "device_id": "MST-PC-002",
  "device_token": "PASTE-THE-TOKEN-FROM-register-agent.php",
  "heartbeat_interval_seconds": 30,
  "send_interval_seconds": 5,
  "watch_folders": [
    "{UserProfile}",
    "{OtherDrives}",
    "{RemovableDrives}"
  ],
  "watch_recycle_bin": true,
  "ignore_folders": [
    "AppData",
    "$Recycle.Bin",
    "System Volume Information",
    "Windows",
    "Program Files",
    "Program Files (x86)",
    "ProgramData",
    "Recovery",
    "PerfLogs",
    "$WinREAgent",
    "MSOCache",
    "Temp",
    "tmp",
    "node_modules",
    ".git",
    ".venv",
    "venv",
    "__pycache__",
    ".cache",
    ".vscode",
    ".idea",
    "IntelGraphicsProfiles",
    "MicrosoftEdgeBackups"
  ],
  "recursive": true,
  "ignore_extensions": [
    ".tmp",
    ".crdownload",
    ".part",
    ".partial",
    ".download",
    ".opdownload",
    ".swp",
    ".lnk",
    ".ini"
  ],
  "ignore_name_prefixes": [
    "~$",
    ".~",
    "~WRL",
    "NTUSER",
    "ntuser",
    "UsrClass",
    "Thumbs.db",
    "desktop.ini"
  ],
  "max_hash_size_mb": 200,
  "queue_file": "mst_agent_queue.db",
  "log_file": "mst_agent.log",
  "request_timeout_seconds": 10,
  "tls_ca_bundle": "",
  "antivirus": "auto",
  "clamav_path": "",
  "scan_timeout_seconds": 120,
  "quarantine_folder": "quarantine"
}
