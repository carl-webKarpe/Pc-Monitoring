# MST web-folder protection for Apache / XAMPP (the same rules as router.php for php -S).
# Never serve configuration, source, database, agent or Git files from the project folder.

<IfModule mod_alias.c>
  RedirectMatch 404 (?i)^/?(.*/)?(\.env|\.git|\.venv|\.htaccess|router\.php)(/|$|\.)
  RedirectMatch 404 (?i)^/?(.*/)?(backend|database|agent|venv)(/|$)
  RedirectMatch 404 (?i)\.(sql|md|json|db|log|ini|py|pyc|ps1|bat)$
</IfModule>

Options -Indexes

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "DENY"
  Header always set Referrer-Policy "no-referrer"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
  Header always set Content-Security-Policy "frame-ancestors 'none'; object-src 'none'; base-uri 'self'; form-action 'self'"
</IfModule>
